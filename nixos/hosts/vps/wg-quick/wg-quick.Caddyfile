#
# Note that sub domains require a A or CNAME record in the DNS
#
# eg sub IN CNAME domain.com.
#

# Audiobookshelf proxy
audiobookshelf.hayzen.uk {
    log

    reverse_proxy https://socat-https:9443 {
        transport http {
            tls_server_name {http.request.host}
            tls_insecure_skip_verify
        }

        header_up Host {host}
    }
}

# Bitwarden proxy
bitwarden.hayzen.uk {
    log

    # Use socat from host
    reverse_proxy https://socat-https:9443 {
        transport http {
            tls_server_name {http.request.host}
            tls_insecure_skip_verify
        }

        header_up Host {host}
    }
}

